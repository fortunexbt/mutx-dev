{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
    "backend": {
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "infrastructure/docker/Dockerfile.backend"
      },
      "deploy": {
        "startCommand": "sh -c 'pip install psycopg2-binary -q 2>/dev/null && alembic upgrade head && uvicorn src.api.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips=\"${FORWARDED_ALLOW_IPS:?FORWARDED_ALLOW_IPS must be set}\"'"
      }
    },
    "frontend": {
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "infrastructure/docker/Dockerfile.frontend",
        "target": "runner"
      },
      "deploy": {
        "startCommand": "node .next/standalone/server.js",
        "numReplicas": 1,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      }
    }
  }
}
