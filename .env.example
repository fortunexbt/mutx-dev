# MUTX Environment Configuration
# Copy this file to .env and fill in your values

# Database (Docker PostgreSQL)
DATABASE_URL=postgresql://mutx:mutx_password@localhost:5432/mutx
# Optional when the PostgreSQL proxy rejects SSL upgrade attempts
DATABASE_SSL_MODE=disable
# SQLite is supported only with one API process; PostgreSQL supports multiple workers.
WEB_CONCURRENCY=1

# JWT Secret (required in production; generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))")
# Leave unset for local development to use an ephemeral auto-generated secret.
# JWT_SECRET=
# Durable idempotent overlap for refresh rotation retries (1-60 seconds).
REFRESH_TOKEN_ROTATION_GRACE_SECONDS=10

# Receipt signing is optional outside production. Keys are raw Ed25519 values encoded as hex.
# The trusted registry is verifier-controlled JSON; its entry must match the private key.
# RECEIPT_SIGNING_KEY_ID=mutx-platform-2026-01
# RECEIPT_SIGNING_PRIVATE_KEY=<64-hex-character-raw-private-key>
# RECEIPT_TRUSTED_PUBLIC_KEYS={"mutx-platform-2026-01":"<64-hex-character-raw-public-key>"}

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://app.localhost:3000,http://pico.localhost:3000,https://mutx.dev,https://app.mutx.dev,https://pico.mutx.dev
AUTH_REDIRECT_ORIGINS=http://localhost:3000,http://app.localhost:3000,http://pico.localhost:3000,https://mutx.dev,https://app.mutx.dev,https://pico.mutx.dev
# Required when using /v1/auth/sso/*; use the externally reachable API origin.
PUBLIC_API_URL=http://localhost:8000
OAUTH_STATE_TTL_SECONDS=600
PICO_TUTOR_MODEL=gpt-5-mini

# Cloudflare Turnstile (required for waitlist signups)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email (optional)
RESEND_API_KEY=***
RESEND_AUDIENCE_ID=
RESEND_FROM_EMAIL=MUTX <hello@mutx.dev>
CONTACT_NOTIFY_EMAIL=hello@mutx.dev
LEAD_DISCORD_WEBHOOK_URL=
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=72

# Stripe billing (required for Pico paid plans)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
# Server-controlled one-time paid-plan trial. Set to 0 to disable; maximum 30.
STRIPE_TRIAL_DAYS=7

# Hosted OAuth providers (optional, but required for Google/GitHub/Discord/Apple auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Apple Sign In. Supply the .p8 key through your secret manager in production.
# For local dotenv files, keep PEM newlines escaped (\\n) inside one quoted value;
# an unquoted multiline key makes the entire environment file invalid.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=""

# Enterprise SSO providers (optional; set each provider group completely)
OKTA_DOMAIN=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
KEYCLOAK_DOMAIN=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# External OIDC validation (optional; set all three values together)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_JWKS_URI=

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=

# Redis
REDIS_URL=redis://localhost:6379/0

# Environment
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO
JSON_LOGGING=false
# LOG_FILE=/var/log/mutx/api.log
