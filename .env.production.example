# Production Environment Variables
# Copy this file to .env.production and fill in your values

# Database
POSTGRES_USER=mutx
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=mutx
DATABASE_URL=postgresql://mutx:your-secure-password@postgres:5432/mutx
# The bundled Postgres service is internal and does not terminate TLS.
# External managed databases should normally set this to require or verify-full.
DATABASE_SSL_MODE=disable
DATABASE_REQUIRED_ON_STARTUP=true
# API worker count. Production uses PostgreSQL; tune only after load testing.
WEB_CONCURRENCY=1

# Authentication and encrypted credential storage (use distinct values)
JWT_SECRET=your-secure-jwt-secret-min-32-chars
SECRET_ENCRYPTION_KEY=your-distinct-encryption-secret-min-32-chars
REFRESH_TOKEN_ROTATION_GRACE_SECONDS=10
REQUIRE_EMAIL_VERIFICATION=true

# Required receipt trust boundary. Rotate by changing the immutable key ID and retaining
# old public keys in the verifier-controlled registry for historical receipt verification.
RECEIPT_SIGNING_KEY_ID=mutx-platform-2026-01
RECEIPT_SIGNING_PRIVATE_KEY=<64-hex-character-raw-private-key>
RECEIPT_TRUSTED_PUBLIC_KEYS={"mutx-platform-2026-01":"<64-hex-character-raw-public-key>"}

# Transactional email (required while email verification is enabled)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="MUTX <hello@mutx.dev>"
CONTACT_NOTIFY_EMAIL=hello@mutx.dev
# Optional confirmation/subscription configuration for public forms.
RESEND_WAITLIST_TEMPLATE_ID=
RESEND_CONTACT_TEMPLATE_ID=
RESEND_AUDIENCE_ID=
LEAD_DISCORD_WEBHOOK_URL=
# SMTP is an optional fallback when Resend is unavailable.
SMTP_USER=
SMTP_PASSWORD=

# Server-controlled one-time paid-plan trial. Set to 0 to disable; maximum 30.
STRIPE_TRIAL_DAYS=7

# Public form abuse protection (both halves are required for waitlist signup)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key

# URLs
NEXT_PUBLIC_API_URL=https://api.mutx.dev
NEXT_PUBLIC_SITE_URL=https://mutx.dev
CORS_ORIGINS=https://mutx.dev,https://app.mutx.dev,https://pico.mutx.dev
FRONTEND_URL=https://app.mutx.dev
PUBLIC_API_URL=https://api.mutx.dev
AUTH_REDIRECT_ORIGINS=https://mutx.dev,https://app.mutx.dev,https://pico.mutx.dev
ALLOWED_HOSTS=api.mutx.dev,api,localhost,127.0.0.1
MUTX_API_HOST=api.mutx.dev

# Trust only this deployment's private Compose bridge as a forwarded-header source.
# Choose an RFC1918 subnet that does not overlap the host or another Docker network.
MUTX_NETWORK_SUBNET=172.30.40.0/24
FORWARDED_ALLOW_IPS=172.30.40.0/24

# Public edge publishing. Change to a specific host interface only when intentional.
MUTX_EDGE_BIND_ADDRESS=0.0.0.0
MUTX_HTTP_HOST_PORT=80
MUTX_HTTPS_HOST_PORT=443

# The monitor healthcheck fails when no successful cycle is fresh or failures are bounded out.
MONITOR_HEARTBEAT_MAX_AGE_SECONDS=30
MONITOR_MAX_CONSECUTIVE_FAILURES=3

# Stable Compose identity, persistent volumes, and TLS mount.
COMPOSE_PROJECT_NAME=docker
MUTX_POSTGRES_VOLUME_NAME=docker_postgres_data
MUTX_REDIS_VOLUME_NAME=docker_redis_data
MUTX_SSL_DIR=./ssl
