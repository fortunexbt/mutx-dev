{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "MUTX Helm values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api",
    "frontend",
    "features",
    "workers",
    "migrations",
    "persistence",
    "ingress",
    "serviceAccount",
    "tests"
  ],
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations", "automountServiceAccountToken"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "podAnnotations": { "$ref": "#/definitions/stringMap" },
    "podLabels": { "$ref": "#/definitions/stringMap" },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "api": { "$ref": "#/definitions/api" },
    "frontend": { "$ref": "#/definitions/frontend" },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documents", "reasoning"],
      "properties": {
        "documents": { "type": "boolean" },
        "reasoning": { "type": "boolean" }
      }
    },
    "workers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["monitor", "document", "reasoning"],
      "properties": {
        "monitor": { "$ref": "#/definitions/monitorWorker" },
        "document": { "$ref": "#/definitions/worker" },
        "reasoning": { "$ref": "#/definitions/worker" }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "backoffLimit",
        "activeDeadlineSeconds",
        "serviceAccountName",
        "resources"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "serviceAccountName": { "type": "string", "minLength": 1 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "existingClaim",
        "storageClass",
        "accessModes",
        "size",
        "retain",
        "annotations",
        "mountPath"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]
          }
        },
        "size": { "type": "string", "minLength": 1 },
        "retain": { "type": "boolean" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "mountPath": { "type": "string", "pattern": "^/" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "className", "annotations", "host", "tls"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "host": { "type": "string" },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "secretName"],
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          }
        }
      }
    },
    "nodeSelector": { "$ref": "#/definitions/stringMap" },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" }
      }
    }
  },
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "envMap": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" },
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port", "annotations"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limits", "requests"],
      "properties": {
        "limits": { "$ref": "#/definitions/resourceMap" },
        "requests": { "$ref": "#/definitions/resourceMap" }
      }
    },
    "resourceMap": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number"] }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minReplicas", "maxReplicas", "targetCPUUtilizationPercentage"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "probeTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failureThreshold", "periodSeconds"],
      "properties": {
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "liveness", "readiness"],
      "properties": {
        "startup": { "$ref": "#/definitions/probeTiming" },
        "liveness": { "$ref": "#/definitions/probeTiming" },
        "readiness": { "$ref": "#/definitions/probeTiming" }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicaCount",
        "image",
        "port",
        "existingSecret",
        "secretEnv",
        "env",
        "service",
        "resources",
        "probes"
      ],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1, "maximum": 1 },
        "image": { "$ref": "#/definitions/image" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "existingSecret": { "type": "string" },
        "secretEnv": { "$ref": "#/definitions/envMap" },
        "env": { "$ref": "#/definitions/envMap" },
        "service": { "$ref": "#/definitions/service" },
        "resources": { "$ref": "#/definitions/resources" },
        "probes": { "$ref": "#/definitions/probes" }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicaCount",
        "image",
        "port",
        "existingSecret",
        "secretEnv",
        "env",
        "service",
        "resources",
        "probes",
        "autoscaling"
      ],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/image" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "existingSecret": { "type": "string" },
        "secretEnv": { "$ref": "#/definitions/envMap" },
        "env": { "$ref": "#/definitions/envMap" },
        "service": { "$ref": "#/definitions/service" },
        "resources": { "$ref": "#/definitions/resources" },
        "probes": { "$ref": "#/definitions/probes" },
        "autoscaling": { "$ref": "#/definitions/autoscaling" }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "replicaCount", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1, "maximum": 1 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "monitorWorker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "replicaCount",
        "heartbeatMaxAgeSeconds",
        "maxConsecutiveFailures",
        "probes",
        "resources"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1, "maximum": 1 },
        "heartbeatMaxAgeSeconds": { "type": "integer", "minimum": 1 },
        "maxConsecutiveFailures": { "type": "integer", "minimum": 1 },
        "probes": { "$ref": "#/definitions/probes" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    }
  }
}
