# =============================================================================
# Production Dockerfile for MUTX API
# Multi-stage build with non-root user, health checks, and graceful shutdown
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Builder - Install dependencies
# -----------------------------------------------------------------------------
FROM python:3.11-slim-bookworm@sha256:b18992999dbe963a45a8a4da40ac2b1975be1a776d939d098c647482bcad5cba AS builder

WORKDIR /build

# Install build dependencies
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install Python dependencies
COPY requirements-runtime.lock .
# hadolint ignore=DL3013
RUN python -m pip install --no-cache-dir \
    --disable-pip-version-check \
    --require-hashes \
    --only-binary=:all: \
    --requirement requirements-runtime.lock

# -----------------------------------------------------------------------------
# Stage 2: Production - Runtime image
# -----------------------------------------------------------------------------
FROM python:3.11-slim-bookworm@sha256:b18992999dbe963a45a8a4da40ac2b1975be1a776d939d098c647482bcad5cba AS production

# Install the PostgreSQL runtime library used by the API and migrations.
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash appuser

WORKDIR /app

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy application code
COPY --chown=appuser:appuser src /app/src
COPY --chown=appuser:appuser pyproject.toml /app/
COPY --chown=appuser:appuser alembic.ini /app/

# Environment variables for production
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONHASHSEED=0 \
    ENVIRONMENT=production \
    LOG_LEVEL=info \
    FORWARDED_ALLOW_IPS=127.0.0.1

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 8000

# Health check verifies the JSON readiness contract without requiring curl.
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD ["python", "-c", "import http.client, json; connection = http.client.HTTPConnection('localhost', 8000, timeout=5); connection.request('GET', '/ready'); response = connection.getresponse(); payload = json.load(response); assert response.status == 200 and payload.get('status') == 'ready' and payload.get('database') == 'ready'"]

CMD ["sh", "-c", "uvicorn src.api.main:app --host ${API_HOST:-0.0.0.0} --port ${API_PORT:-8000} --workers ${WEB_CONCURRENCY:-1} --log-level $(printf '%s' \"${LOG_LEVEL:-info}\" | tr '[:upper:]' '[:lower:]') --proxy-headers --forwarded-allow-ips=\"${FORWARDED_ALLOW_IPS:-127.0.0.1}\""]
